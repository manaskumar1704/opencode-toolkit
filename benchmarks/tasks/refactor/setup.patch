+"""Deliberately convoluted implementation to simplify."""
+
+
+def _normalise(value):
+    if value < 0:
+        return -value
+    else:
+        return value
+
+
+def _apply(value):
+    return _normalise(value)
+
+
+def magnitude(values):
+    result = []
+    for value in values:
+        result.append(_apply(value))
+    return result
