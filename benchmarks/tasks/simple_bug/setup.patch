@@ -0,0 +1,9 @@
+from octk.simple import last_n
+
+
+def test_last_n_basic():
+    assert last_n([1, 2, 3, 4, 5], 2) == [4, 5]
+
+
+def test_last_n_zero():
+    assert last_n([1, 2, 3], 0) == []
