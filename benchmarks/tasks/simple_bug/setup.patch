@@ -0,0 +1,12 @@
+"""A tiny helper module used by the simple-bug benchmark task."""
+
+
+def last_n(items, n):
+    """Return the last ``n`` items of ``items``."""
+    if n <= 0:
+        return []
+    # Bug: off by one - slices one too many.
+    return items[-(n + 1):]
+
+
+__all__ = ["last_n"]
