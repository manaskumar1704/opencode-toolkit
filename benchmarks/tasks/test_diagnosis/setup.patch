@@ -0,0 +1,9 @@
+"""Source under test for the diagnosis task."""
+
+
+def parse_pairs(text):
+    pairs = {}
+    for line in text.splitlines():
+        key, value = line.split("=")
+        pairs[key] = value
+    return pairs
