{
  "mcp": {
    "servers": {
      "octk": {
        "type": "local",
        "command": [
          "octk-mcp"
        ],
        "codemode": false
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "octk approve *",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".toolkit/approvals.json",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".toolkit/metrics.json",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".toolkit/specs/roadmap.md",
      "effect": "ask"
    }
  ]
}